# Copy to .env and adjust. Every value here is also the built-in default,
# so an empty .env behaves the same as no .env at all.

# Host the UI tests run against. Page objects hold paths, so pointing this at a
# local build of the app is enough to run the same suite against it.
BASE_URL=https://demo.playwright.dev

# Host the API tests run against.
API_BASE_URL=https://jsonplaceholder.typicode.com

# Set to false to watch the browser. `npm run test:headed` does the same per-run.
HEADLESS=true

# Leave empty to use Playwright's bundled Chromium. Set to `chrome` or `msedge` to run
# against a browser already installed on the machine — for reproducing something that only
# happens in the real browser, or when the bundled download is unavailable.
BROWSER_CHANNEL=
