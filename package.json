{
  "name": "playwright-e2e-tests",
  "version": "1.0.0",
  "description": "UI and API test automation framework built with Playwright, TypeScript and Allure",
  "author": "Denys Riabykh <denisryabykh@gmail.com> (https://github.com/sp1r1n)",
  "license": "MIT",
  "private": true,
  "homepage": "https://sp1r1n.github.io/playwright/",
  "repository": {
    "type": "git",
    "url": "https://github.com/sp1r1n/playwright.git"
  },
  "bugs": {
    "url": "https://github.com/sp1r1n/playwright/issues"
  },
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "e2e-testing",
    "api-testing",
    "allure",
    "page-object-model",
    "qa"
  ],
  "scripts": {
    "install:browsers": "playwright install --with-deps chromium",
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-tests",
    "test:api": "playwright test --project=api-tests",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "allure:generate": "allure generate allure-results -o allure-report --clean",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml,yaml}\"",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "allure-commandline": "^2.43.0",
    "allure-js-commons": "^3.10.2",
    "allure-playwright": "^3.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
